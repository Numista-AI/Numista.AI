# numista_backend/.env.example
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to version control.
#
# For Cloud Run: set these as Secret Manager secrets or Cloud Run env vars
# in the deploy step of .github/workflows/deploy-production.yml

# ── eBay Production API ───────────────────────────────────────────────────────
EBAY_APP_ID=your-ebay-production-app-id
EBAY_CERT_ID=your-ebay-production-cert-id

# ── PCGS API ──────────────────────────────────────────────────────────────────
PCGS_ALT_TOKEN=your-pcgs-bearer-token   # only needed for test_new_credentials.py

# ── Google Cloud ──────────────────────────────────────────────────────────────
# For local dev only — Cloud Run uses the service account automatically
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
