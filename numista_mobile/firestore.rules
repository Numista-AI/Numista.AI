rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    // Returns true if the request comes from a signed-in, non-anonymous user.
    function isAuthenticated() {
      return request.auth != null && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
    }

    // Returns true if the signed-in user's email or UID matches the {email} path segment.
    function isOwner(email) {
      return request.auth != null && (request.auth.token.email == email || request.auth.uid == email);
    }

    // ── Estate reports — attorney portal token access ─────────────────────────
    // The report document ID IS the access token (a crypto-random UUID).
    // Any request that knows the exact reportId may GET that single document.
    // This enables the no-auth attorney portal while keeping data private
    // (the UUID is unguessable; the user controls the link).
    // IMPORTANT: This rule must come BEFORE the wildcard /users/{email}/{document=**}
    // rule so Firestore evaluates the more specific path first.
    match /users/{email}/estate_reports/{reportId} {
      allow read:  if isOwner(email);  // owner sees all their reports (list + get)
      allow get:   if true;            // attorney portal — token == reportId
      allow write: if false;           // backend SA only
    }

    // ── ADDENDUM B: Field-level rules for protected demo/sandbox keys ─────────
    // These more-specific match blocks are evaluated BEFORE the wildcard
    // /users/{email}/{document=**} block below.
    //
    // Allowed on create: is_demo: false only (never is_demo: true).
    //   Client may explicitly stamp is_demo: false and is_demo_cleared: false on
    //   new real-coin creates (Option 1 of the ITEM 6 coding constraint).
    //   This keeps real coins visible once the WHERE is_demo == false filter ships.
    // Blocked on update: client may never change is_demo or is_demo_cleared on
    //   existing documents. Only Admin SDK / backend service account may do so.
    // Admin SDK bypasses all rules (standard Firestore behavior).
    match /users/{email}/coins/{coinId} {
      // Owner reads their own coins (list + get)
      allow read: if isOwner(email);

      // Owner deletes their own coins (soft-archive is done server-side;
      // hard delete is not used in this sprint, but not blocked at rules level)
      allow delete: if isOwner(email);

      // Owner creates a new coin:
      //   - is_demo MUST be present in the document AND explicitly false.
      //     get('is_demo', false) != true would allow omitting the field entirely;
      //     the display filter WHERE is_demo == false would then hide that coin.
      //   - is_demo_cleared MUST be present AND explicitly false.
      //   Admin SDK / Cloud Run creators bypass these rules and must write both
      //   fields in the payload (enforced by server-side payload unit tests).
      allow create: if isOwner(email)
                    && request.resource.data.keys().hasAll(['is_demo', 'is_demo_cleared'])
                    && request.resource.data.is_demo == false
                    && request.resource.data.is_demo_cleared == false;

      // Owner updates an existing coin:
      //   - may not change is_demo (any direction)
      //   - may not change is_demo_cleared (any direction)
      allow update: if isOwner(email)
                    && !request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasAny(['is_demo', 'is_demo_cleared']);
    }

    // NOTE: match /users/{email}/profile was removed (13 Oct 2026).
    //   The app does not use a profile subcollection directly.
    //   sandbox_cleared, is_lifetime_family_estate, is_ai_qc_account, and
    //   beta_tester all live on the users/{email} doc itself and are guarded
    //   by _serverOnlyKeys() / _noEntitlementChange() below.

    // ── Settings (ui_variant, etc. — server-only writes via Admin SDK) ─────────
    match /users/{email}/settings/{doc} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;  // server-only writes via Admin SDK
    }

    // Server-only entitlement fields — owner MUST NOT be able to set these.
    // The server (Admin SDK) sets them; any client write that touches them is denied.
    // On create: those fields must be absent (or default false/null).
    // On update: the diff must not include any of these keys.
    function _serverOnlyKeys() {
      return ['tier', 'stripe_tier', 'beta_tester', 'is_lifetime_family_estate',
              'is_ai_qc_account', 'is_bot_account', 'sandbox_cleared', 'admin'];
    }
    function _noEntitlementChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(_serverOnlyKeys());
    }
    function _noEntitlementOnCreate() {
      return !request.resource.data.keys().hasAny(_serverOnlyKeys());
    }

    match /users/{email} {
      allow read: if isOwner(email);
      // Owner may create their own user doc only if entitlement fields are absent.
      allow create: if isOwner(email) && _noEntitlementOnCreate();
      // Owner may update only if they don't touch any entitlement field.
      allow update: if isOwner(email) && _noEntitlementChange();
      // Deletes not allowed from client (would lose all data).
      allow delete: if false;
    }
    // Subcollections the owner CAN read+write (wishlist, review_queue, morgan_proposals, etc.)
    // coins and profile are excluded because they have more-specific blocks above.
    match /users/{email}/{sub}/{docId} {
      allow read, write: if isOwner(email)
        && !(sub in ['settings', 'estate_reports', 'morgan_action_log', 'trash', 'audit_log', 'coins', 'profile']);
    }
    // Nested docs within writable subcollections
    match /users/{email}/{sub}/{docId}/{rest=**} {
      allow read, write: if isOwner(email)
        && !(sub in ['settings', 'estate_reports', 'morgan_action_log', 'trash', 'audit_log', 'coins', 'profile']);
    }
    // Server-only subcollections — owner may read but NOT write (server SA only)
    match /users/{email}/settings/{docId} {
      allow read: if isOwner(email);
      allow write: if false;
    }
    match /users/{email}/estate_reports/{docId} {
      allow read: if isOwner(email);
      allow write: if false;
    }
    match /users/{email}/morgan_action_log/{docId} {
      allow read: if isOwner(email);
      allow write: if false;
    }
    match /users/{email}/trash/{docId} {
      allow read: if isOwner(email);
      allow write: if false;
    }
    match /users/{email}/audit_log/{docId} {
      allow read: if isOwner(email);
      allow write: if false;
    }

    // ── Global programs (reference data — public read, no writes from client) ─
    match /global_programs/{programId} {
      allow read: if true;
      allow write: if false;  // backend service account only
    }

    // ── Config (PCGS token, NewsAPI key, eBay public config, etc.) ─────────────
    // Read access needed by the Flutter client to fetch non-sensitive platform config.
    // Client secrets (e.g. cert_id) are strictly prohibited and unreadable (REQ-023E M4).
    // Write access restricted to admin (backend service account bypasses rules).
    match /config/ebay {
      allow read: if isAuthenticated() && !('cert_id' in resource.data);
      allow write: if false;  // backend service account only
    }

    match /config/{document=**} {
      allow read: if isAuthenticated() && (!('cert_id' in resource.data));
      allow write: if false;  // backend service account only
    }

    // ── Coin image index (reference library — authenticated read) ─────────────
    // Non-sensitive reference data built by build_image_index.py from GCS buckets.
    // Any signed-in user may read; only the backend service account may write.
    match /coin_image_index/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;  // backend service account only
    }

    // ── Coin set index (reference library — authenticated read) ───────────────
    // Pre-cataloged set manifests populated by the backend ingestion pipeline.
    // Any signed-in user may read; only the backend service account may write.
    match /coin_set_index/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;  // backend service account only
    }

    // ── Mint Error Library (reference data — authenticated read) ──────────────
    // Public-facing error encyclopedia populated by the backend ingestion pipeline.
    // Any signed-in user may read; client writes are forbidden (backend SA only).
    match /mint_errors/{errorId} {
      allow read:  if isAuthenticated();
      allow write: if false;  // backend service account only
    }

    // ── Backend-managed collections ───────────────────────────────────────────
    match /pending_items/{document=**} {
      allow read, write: if false; // backend service account only
    }

    match /supplies_log/{document=**} {
      allow read, write: if false; // backend service account only
    }

    match /admin_grade_flags/{document=**} {
      allow read, write: if false; // backend service account only
    }

    // ── Microscope / Hardware Agent Commands ──────────────────────────────────
    match /commands/{email}/pending/{commandId} {
      allow create: if isOwner(email);
      allow read, write: if false; // Only agent (SA) reads/deletes
    }

    match /commands/{email}/results/{resultId} {
      allow read: if isOwner(email);
      allow write: if false; // Only agent (SA) writes
    }

    // ── Beta Feedback ─────────────────────────────────────────────────────────
    // ALL writes (create, update, delete) go through the Cloud Run callable.
    // The callable uses the Firebase Admin SDK (bypasses these rules).
    // Admin reads are done via service account; tester reads blocked.
    // Clients may read their own submissions (status tracking).
    match /beta_feedback/{feedbackId} {
      // Tester: read own submission only (for post-submit correction check)
      allow get: if request.auth != null
                 && resource.data.user_id == request.auth.uid;
      // Admin: list/read all (via Admin SDK — bypasses rules; kept as belt-and-suspenders)
      allow list: if request.auth != null && request.auth.token.admin == true;
      // ALL writes: callable / Admin SDK only; client writes blocked
      allow create, update, delete: if false;
    }

    // ── Public Wishlists (family gift reservations) ───────────────────────────
    match /public_wishlists/{token} {
      allow get: if true;
      allow create: if request.auth != null;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny(['reserved_items', 'reservation_details']);
    }

    // ── Estate Reports / Attorney Portal Tokens (Public Token Read, Hardened Owner Update) ────
    match /estate_reports/{token} {
      allow read: if resource.data.status == 'active'
                  && resource.data.expires_at is string;
      allow create: if request.auth != null
                    && request.resource.data.owner_uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.owner_uid == request.auth.uid
                    && request.resource.data.owner_uid == resource.data.owner_uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']);
      allow delete: if request.auth != null
                    && resource.data.owner_uid == request.auth.uid;

      match /access_logs/{logId} {
        allow read, write: if false; // backend service account only
      }
    }

    // ── Attorney Portal Tokens (ITEM B — B5) ─────────────────────────────────
    // SHA-256 hashes of raw attorney tokens.
    // All reads and writes go through Cloud Run (POST /api/attorney/issue,
    // GET /api/attorney/snapshot, POST /api/attorney/revoke).
    // No client SDK may read or write this collection directly —
    // including the authenticated owner.
    // Admin SDK bypasses these rules (standard Firestore behavior).
    match /attorney_tokens/{tokenHash} {
      allow read, write: if false;  // Cloud Run + Admin SDK only
    }

    // ── Family Sub-Account Resource Groups (authenticated member access) ──────
    match /family_groups/{familyGroupId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.primary_owner_uid;
    }

    // ── Help Tickets ──────────────────────────────────────────────────────────
    // Base document: no grant token, no diagnostic data — safe for admin queue read.
    // Sensitive sub-document (private/grant_and_diag): allow read, write: if false
    // → backend service account only (Admin SDK bypasses rules).
    match /tickets/{ticket_id} {
      // User creates their own ticket; grant_active must be false on create
      allow create: if isAuthenticated()
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.get('grant_active', false) == false;

      // User reads own tickets; admin reads all (base doc only — no sensitive fields here)
      allow read: if isAuthenticated()
                  && (resource.data.user_id == request.auth.uid
                      || request.auth.token.admin == true);

      // User may update subject/description/status only while no grant is active
      allow update: if isAuthenticated()
                    && resource.data.user_id == request.auth.uid
                    && resource.data.get('grant_active', false) == false;

      allow delete: if false;

      // ── Sensitive private sub-document ─────────────────────────────────────
      // Contains support_grant (token_hash) and diagnostic_package.
      // ONLY the backend service account (Admin SDK) may read or write this.
      match /private/{doc} {
        allow read, write: if false;
      }

      // ── Messages ────────────────────────────────────────────────────────────
      // User posts and reads their own ticket messages.
      // Support posts and reads via backend Admin SDK only (not direct Firestore).
      match /messages/{message_id} {
        allow create: if isAuthenticated()
                      && get(/databases/$(database)/documents/tickets/$(ticket_id))
                           .data.user_id == request.auth.uid;
        allow read:   if isAuthenticated()
                      && get(/databases/$(database)/documents/tickets/$(ticket_id))
                           .data.user_id == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Support Access Audit Log ──────────────────────────────────────────────
    // Backend service account writes. Admin may read for audit review.
    // Clients cannot write audit log entries.
    match /support_access_logs/{log_id} {
      allow read:  if request.auth != null && request.auth.token.admin == true;
      allow write: if false;  // backend service account only via Admin SDK
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
